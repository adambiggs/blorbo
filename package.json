{
  "name": "blorbo",
  "version": "0.1.2",
  "description": "Canvas background shaped by page text, images, pointer, and scroll",
  "type": "module",
  "module": "./dist/blorbo.js",
  "unpkg": "./dist/blorbo.iife.js",
  "jsdelivr": "./dist/blorbo.iife.js",
  "exports": {
    ".": "./dist/blorbo.js",
    "./inputs": "./src/inputs.js",
    "./presets": "./src/presets.js"
  },
  "sideEffects": false,
  "files": ["dist", "src", "docs", "demo", "LICENSE", "README.md", "CHANGELOG.md", "CONTRIBUTING.md"],
  "engines": { "node": ">=20.11" },
  "repository": { "type": "git", "url": "git+https://github.com/adambiggs/blorbo.git" },
  "homepage": "https://github.com/adambiggs/blorbo#readme",
  "bugs": { "url": "https://github.com/adambiggs/blorbo/issues" },
  "keywords": ["page-content", "content-reactive", "canvas", "background", "animation", "visualization"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run test:unit && npm run test:docs && npm run test:runtime",
    "test:unit": "npm run build && node --test test/unit/*.test.mjs",
    "test:docs": "npm run build && node --test test/docs.test.mjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test-coverage-include='src/*.js' --test test/unit/*.test.mjs",
    "snapshots:reference": "npm run build && node test/snapshots.mjs reference",
    "snapshots:compare": "npm run build && node test/snapshots.mjs compare",
    "snapshots:sites": "node test/site-snapshots.mjs compare",
    "snapshots:sites:reference": "node test/site-snapshots.mjs reference",
    "test:runtime": "node test/runtime.mjs",
    "perf": "node test/perf.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0"
  },
  "license": "Apache-2.0"
}
