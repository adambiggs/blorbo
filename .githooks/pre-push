#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
started=$SECONDS
trap 'printf "Gate total: %ss\n" "$((SECONDS - started))"' EXIT

run_part() {
  local name=$1 part_started=$SECONDS
  shift
  "$@"
  printf '%s: %ss\n' "$name" "$((SECONDS - part_started))"
}

run_part 'Unit tests' npm run test:unit
run_part 'Package check' npm pack --dry-run
